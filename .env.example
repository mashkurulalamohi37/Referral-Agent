# Copy to .env for local development:  cp .env.example .env
# Every value here is a LOCAL DEVELOPMENT placeholder. The app refuses to start with
# APP_ENV=staging|prod if any secret below still contains "dev-only" or is shorter than 32 chars.
# Product API keys are NOT environment variables: they are created per product (operator CLI /
# admin panel) and stored hashed (spec §25).

# ---------------------------------------------------------------- runtime
# local | test | staging | prod. Controls secret checks and API docs exposure.
APP_ENV=local
# Python logging level for JSON logs.
LOG_LEVEL=INFO
# Comma-separated ISO-4217 currencies accepted in events and APIs (Q13: BDT only in v1).
ENABLED_CURRENCIES=BDT
# Default display time zone for users (storage is always UTC).
DEFAULT_TIME_ZONE=Asia/Dhaka
# Force /v1/docs, /v1/redoc, /v1/openapi.json on or off. Empty = on for local/test, off otherwise.
API_DOCS_ENABLED=

# ---------------------------------------------------------------- database (PostgreSQL 16)
# Superuser, used only by the postgres container's init script.
POSTGRES_SUPERUSER_PASSWORD=dev-only-postgres-superuser
# Schema owner role, used only by migrations (MIGRATION_DATABASE_URL).
REFERRAL_OWNER_PASSWORD=dev-only-owner-password
# DML-only application role (DATABASE_URL). Cannot alter tables or disable triggers.
REFERRAL_APP_PASSWORD=dev-only-app-password
# In Docker Compose these two URLs are built from the passwords above; set them explicitly
# only when running the backend outside Compose.
DATABASE_URL=postgresql+asyncpg://referral_app:dev-only-app-password@localhost:5433/referral
MIGRATION_DATABASE_URL=postgresql+asyncpg://referral_owner:dev-only-owner-password@localhost:5433/referral
# Connection pool per process.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# ---------------------------------------------------------------- redis 7 (Celery broker, rate limits)
REDIS_URL=redis://localhost:6380/0

# ---------------------------------------------------------------- secrets (>= 32 chars each in prod)
# Signs portal/admin JWT access tokens.
JWT_SIGNING_KEY=dev-only-jwt-signing-key-change-me-000000
# Signs attribution tokens (JWS) carried from /r/{code} to product signup (§7.1).
ATTRIBUTION_TOKEN_KEY=dev-only-attribution-token-key-000000000
# HMAC pepper for hashing risk signals (email, phone, IP, device). Rotating it stops old hashes matching.
SIGNAL_HASH_PEPPER=dev-only-signal-hash-pepper-00000000000
# AES-256-GCM key (base64, 32 bytes) for payout details at rest. Separate from all other keys (§13).
PAYOUT_DETAILS_ENCRYPTION_KEY=dev-only-payout-details-key-000000000000
# AES-256-GCM key (base64, 32 bytes) for API client signing secrets and TOTP secrets at rest.
SECRETS_ENCRYPTION_KEY=dev-only-secrets-encryption-key-0000000000

# ---------------------------------------------------------------- public URLs
# Referral link host: https://ref.example.com/r/{CODE}
REFERRAL_BASE_URL=http://localhost:8080
# Customer portal origin (CORS + SSO handoff redirect).
PORTAL_URL=http://localhost:5173
# Admin panel origin (CORS).
ADMIN_URL=http://localhost:5174

# ---------------------------------------------------------------- email (Phase 13)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ---------------------------------------------------------------- observability
# Sentry-compatible DSN for error reporting. Empty = disabled.
SENTRY_DSN=
# OpenTelemetry OTLP endpoint. Empty = tracing disabled.
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------------------------------------------------------------- deployment
# Image tag used by docker compose.
IMAGE_TAG=local
# Host directory with fullchain.pem and privkey.pem (prod Nginx only).
TLS_CERT_DIR=/etc/referral/tls
