{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.referral-platform.example/events/v1/envelope.schema.json",
  "title": "Inbound event envelope (POST /v1/events)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "data"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "description": "Unique per product (§8.4)."
    },
    "event_type": {
      "type": "string",
      "enum": [
        "user.registered",
        "subscription.created",
        "subscription.updated",
        "subscription.cancelled",
        "subscription.expired",
        "payment.succeeded",
        "payment.failed",
        "payment.refunded",
        "payment.chargeback",
        "payment.chargeback_resolved"
      ]
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "occurred_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "data": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "user.registered"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "user.registered.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "subscription.created"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "subscription.created.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "subscription.updated"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "subscription.updated.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "subscription.cancelled"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "subscription.cancelled.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "subscription.expired"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "subscription.expired.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "payment.succeeded"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "payment.succeeded.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "payment.failed"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "payment.failed.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "payment.refunded"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "payment.refunded.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "payment.chargeback"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "payment.chargeback.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "payment.chargeback_resolved"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "payment.chargeback_resolved.schema.json"
          }
        }
      }
    }
  ]
}
