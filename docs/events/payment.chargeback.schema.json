{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.referral-platform.example/events/v1/payment.chargeback.schema.json",
  "title": "payment.chargeback data",
  "description": "chargeback_id added by ADR 0010.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chargeback_id",
    "payment_id",
    "amount",
    "currency",
    "opened_at"
  ],
  "properties": {
    "chargeback_id": {
      "$ref": "common.schema.json#/$defs/external_id"
    },
    "payment_id": {
      "$ref": "common.schema.json#/$defs/external_id"
    },
    "external_user_id": {
      "$ref": "common.schema.json#/$defs/external_id"
    },
    "amount": {
      "$ref": "common.schema.json#/$defs/positive_minor_amount"
    },
    "currency": {
      "$ref": "common.schema.json#/$defs/currency"
    },
    "opened_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    }
  }
}
