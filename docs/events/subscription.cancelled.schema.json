{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.referral-platform.example/events/v1/subscription.cancelled.schema.json",
  "title": "subscription.cancelled data",
  "description": "Stops future renewal commissions only (§12). external_user_id optional; resolved from the subscription (ADR 0012).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subscription_id",
    "effective_at"
  ],
  "properties": {
    "subscription_id": {
      "$ref": "common.schema.json#/$defs/external_id"
    },
    "external_user_id": {
      "$ref": "common.schema.json#/$defs/external_id"
    },
    "effective_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    }
  }
}
